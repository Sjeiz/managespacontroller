{
	"mqtt": {
		"server": "homeassistant.cheizoo.lan",
		"port": 1883,
		"keepalive": 10,
		"qos": 1,
		"subscribe_topic": "spa-controller/+/set",
		"statustopic": "spa-controller/LWT",
		"statusonline": "Online",
		"statusoffline": "Offline",
		"device": {
			"identifiers": [
				"spa-controller"
			],
			"manufacturer": "Sjeiz",
			"name": "Spa Controller",
			"model": "Raspberry Pi 4B Spa Controller",
			"suggested_area": "Garden"
		},
		"sleep": 0.1,
		"republish_sec": 60,
		"debug": "true"
	},
	"gpios": {
		"spa_heatpump": {
			"name": "Spa HeatPump",
			"short_name": "HP",
			"direction": "output",
			"pin": 26,
			"initial_state": "on",
			"conflict": "spa_heater",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_heatpump/config",
			"command_topic": "spa-controller/spa_heatpump/set",
			"state_topic": "spa-controller/spa_heatpump",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 1,
			"gpio_off": 0
		},
		"spa_heater": {
			"name": "Spa Heater",
			"short_name": "HT",
			"direction": "output",
			"pin": 19,
			"initial_state": "off",
			"conflict": "spa_heatpump",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_heater/config",
			"command_topic": "spa-controller/spa_heater/set",
			"state_topic": "spa-controller/spa_heater",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 0,
			"gpio_off": 1,
			"requires": "spa_circulation"
		},
		"spa_circulation": {
			"name": "Spa Circulation Pump",
			"short_name": "C",
			"direction": "output",
			"pin": 13,
			"initial_state": "off",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_circulation/config",
			"command_topic": "spa-controller/spa_circulation/set",
			"state_topic": "spa-controller/spa_circulation",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 0,
			"gpio_off": 1
		},
		"spa_pump1": {
			"name": "Spa Pump #1",
			"short_name": "1",
			"direction": "output",
			"pin": 21,
			"initial_state": "off",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_pump1/config",
			"command_topic": "spa-controller/spa_pump1/set",
			"state_topic": "spa-controller/spa_pump1",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 0,
			"gpio_off": 1
		},
		"spa_pump2": {
			"name": "Spa Pump #2",
			"short_name": "2",
			"direction": "output",
			"pin": 20,
			"initial_state": "off",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_pump2/config",
			"command_topic": "spa-controller/spa_pump2/set",
			"state_topic": "spa-controller/spa_pump2",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 0,
			"gpio_off": 1
		},
		"spa_pump3": {
			"name": "Spa Pump #3",
			"short_name": "3",
			"direction": "output",
			"pin": 7,
			"initial_state": "off",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_pump3/config",
			"command_topic": "spa-controller/spa_pump3/set",
			"state_topic": "spa-controller/spa_pump3",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 0,
			"gpio_off": 1
		},
		"spa_lights": {
			"name": "Spa Lights",
			"short_name": "L",
			"direction": "output",
			"pin": 6,
			"initial_state": "off",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_lights/config",
			"command_topic": "spa-controller/spa_lights/set",
			"state_topic": "spa-controller/spa_lights",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 0,
			"gpio_off": 1
		},
		"spa_blower": {
			"name": "Spa Blower",
			"short_name": "B",
			"direction": "output",
			"pin": 16,
			"initial_state": "off",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_blower/config",
			"command_topic": "spa-controller/spa_blower/set",
			"state_topic": "spa-controller/spa_blower",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 0,
			"gpio_off": 1
		},
		"spa_ozonator": {
			"name": "Spa Ozonator",
			"short_name": "O",
			"direction": "output",
			"pin": 25,
			"initial_state": "off",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_ozonator/config",
			"command_topic": "spa-controller/spa_ozonator/set",
			"state_topic": "spa-controller/spa_ozonator",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 0,
			"gpio_off": 1
		},
		"spa_water_level": {
			"name": "Spa Water Level (OVERRIDE)",
			"direction": "input",
			"pin": 12,
			"device_class": "problem",
			"config_topic": "homeassistant/binary_sensor/spa-controller/spa_water_level/config",
			"state_topic": "spa-controller/spa_water_level",
			"pull_up_down": "up",
			"payload_on": "problem",
			"payload_off": "ok",
			"gpio_on": 0,
			"gpio_off": 1,
			"power": "spa_water_level_power",
			"interval_secs": 10,
			"settle_secs": 0.1
		},
		"spa_water_level_power": {
			"name": "Spa Water Level Power",
			"direction": "output",
			"pin": 22,
			"initial_state": "off",
			"gpio_on": 1,
			"gpio_off": 0
		},
		"spa_buzzer": {
			"name": "Spa Buzzer",
			"direction": "output",
			"pin": 14,
			"initial_state": "off",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 1,
			"gpio_off": 0
		}
	},
	"sensors": {
		"spa_temp_1": {
			"name": "Water Temp",
			"device_class": "temperature",
			"unit_of_measurement": "°C",
			"config_topic": "homeassistant/sensor/spa-controller/spa_temp_1/config",
			"state_topic": "spa-controller/spa_temp_1",
			"sensor_type": "w1sensor",
			"filename": "/sys/bus/w1/devices/28-3c01e076e697/w1_slave",
			"scale": 0.001,
			"round_digits": 1,
			"offset": 0,
			"interval_secs": 10
		},
		"spa_temp_2": {
			"name": "HeatPump Temp",
			"device_class": "temperature",
			"unit_of_measurement": "°C",
			"config_topic": "homeassistant/sensor/spa-controller/spa_temp_2/config",
			"state_topic": "spa-controller/spa_temp_2",
			"sensor_type": "w1sensor",
			"filename": "/sys/bus/w1/devices/28-4164d44388b9/w1_slave",
			"scale": 0.001,
			"round_digits": 1,
			"offset": 0,
			"interval_secs": 10
		},
		"spa_temp_3": {
			"name": "Air Temp",
			"device_class": "temperature",
			"unit_of_measurement": "°C",
			"config_topic": "homeassistant/sensor/spa-controller/spa_temp_3/config",
			"state_topic": "spa-controller/spa_temp_3",
			"sensor_type": "w1sensor",
			"filename": "/sys/bus/w1/devices/28-3c01e076e4f2/w1_slave",
			"scale": 0.001,
			"round_digits": 1,
			"offset": 0,
			"interval_secs": 10
		},
		"spa_timestamp": {
			"name": "Spa Last Update",
			"device_class": "timestamp",
			"config_topic": "homeassistant/sensor/spa-controller/spa_timestamp/config",
			"state_topic": "spa-controller/spa_timestamp",
			"sensor_type": "timestamp",
			"value_template": "{% if value is string and value|length == 13 and value[:-1].isdigit() %}{{ strptime(value[:-1] + ('-+0200' if value[12] == 'S' else '-+0100'), '%y%m%d%H%M%S-%z') }}{% else %}{{ this.state }}{% endif %}"
		}
	},
	"monitors": {
		"spa_status_water": {
			"name": "Spa Status (Water)",
			"device_class": "problem",
			"monitor": {
				"check_01": "state_on, spa_water_level"
			},
			"warning": "WaterLow"
		},
		"spa_status_temp": {
			"name": "Spa Status (Temperature)",
			"device_class": "problem",
			"monitor": {
				"check_01": "value_greater, spa_temp_1, 40"
			},
			"warning": "TempHigh",
			"hysteresis": 0.5
		},
		"spa_status_frost": {
			"name": "Spa Status (Frost)",
			"device_class": "cold",
			"monitor": {
				"check_01": "value_less, spa_temp_3, 4"
			},
			"force_on": "spa_heatpump",
			"unknown_active": true,
			"warning": "Frost"
		}
	},
	"spa": {
		"session_switch": {
			"name": "Spa Session",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_session/config",
			"command_topic": "spa-controller/spa_session/set",
			"state_topic": "spa-controller/spa_session",
			"payload_on": "on",
			"payload_off": "off"
		},
		"operation_sensor": {
			"name": "Spa Operation",
			"config_topic": "homeassistant/sensor/spa-controller/spa_operation/config",
			"state_topic": "spa-controller/spa_operation"
		},
		"status_sensor": {
			"name": "Spa Status",
			"config_topic": "homeassistant/sensor/spa-controller/spa_status/config",
			"state_topic": "spa-controller/spa_status"
		},
		"circulation": "spa_circulation",
		"session_list": [
			[
				"spa_lights",
				"spa_circulation"
			],
			[
				"spa_pump1"
			],
			[
				"spa_pump2"
			],
			[
				"spa_pump3"
			]
		],
		"maintenance_list": [
			[
				"spa_circulation"
			],
			[
				"spa_pump1"
			],
			[
				"spa_pump2"
			],
			[
				"spa_pump3"
			],
			[
				"spa_blower"
			]
		],
		"stagger_secs": 1,
		"maintenance_times": [
			"06:00",
			"14:00",
			"22:00"
		],
		"flush_secs": 30,
		"circulation_secs": 3600,
		"status_log_secs": 300
	},
	"disabled": {
		"spa_pump4": {
			"name": "Spa Pump #4",
			"short_name": "4",
			"direction": "output",
			"pin": 8,
			"initial_state": "off",
			"device_class": "switch",
			"config_topic": "homeassistant/switch/spa-controller/spa_pump4/config",
			"command_topic": "spa-controller/spa_pump4/set",
			"state_topic": "spa-controller/spa_pump4",
			"payload_on": "on",
			"payload_off": "off",
			"gpio_on": 0,
			"gpio_off": 1
		}
	}
}